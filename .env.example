# 复制为 .env 并填入实际值。.env 已被 .gitignore 忽略。

# LLM API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama 自定义地址（可选，默认 http://localhost:11434）
# OLLAMA_HOST=http://192.168.1.100:11434

# Custom / OpenAI-Compatible LLM（任何暴露 /chat/completions 的服务）
# 例如：vLLM / llama.cpp server / LiteLLM / OpenRouter / OneAPI / 自建网关
# CUSTOM_LLM_URL=https://api.example.com/v1
# CUSTOM_LLM_API_KEY=sk-xxx...

# 数据库连接（运行时可在 UI 切换；这里只是初始默认）
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/mydb

# 调试模式（true 会输出更详细日志）
# DEBUG=false
